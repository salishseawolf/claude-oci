# syntax=docker/dockerfile:1

FROM claude-code:latest

LABEL org.opencontainers.image.source="https://github.com/salishseawolf/claude-oci"
LABEL org.opencontainers.image.authors="tgwolf@salishseawolf.com"
LABEL org.opencontainers.image.description="Claude Code CLI with Rust/Cargo development environment"

# Switch to root to install additional packages
USER root

# Install Rust build dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        libssl-dev \
        && \
    rm -rf /var/lib/apt/lists/*

# Install Rust and Cargo
ARG RUST_VERSION=stable
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y && \
    /root/.cargo/bin/rustup default ${RUST_VERSION} && \
    /root/.cargo/bin/rustup component add rustfmt clippy

# Appended, not prepended: mise's shims come first so a project's pinned
# Rust (mise.toml) wins over this image's default `stable` toolchain in
# non-interactive shells, which never run `mise activate`.
ENV PATH=$PATH:/root/.cargo/bin
ENV CARGO_HOME=/root/.cargo
ENV RUSTUP_HOME=/root/.rustup

# Install cargo-binstall (itself a prebuilt binary, no compilation), then use
# it for the dev tools below: it fetches prebuilt binaries where upstream
# publishes them and only falls back to compiling from source when it can't,
# which is far faster than a plain `cargo install` for tools that do.
RUN curl -L --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash

# Install common Rust development tools, then drop the crates.io registry/git
# caches (only the built binaries in $CARGO_HOME/bin are needed at runtime)
RUN cargo binstall --no-confirm cargo-watch cargo-expand cargo-audit && \
    rm -rf /root/.cargo/registry /root/.cargo/git

# Entrypoint is inherited from base image
# ENTRYPOINT ["claude"]